<Window x:Class="WPF_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trung Tâm Quản Lý Tòa Nhà" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5">

    <Grid>
        <TabControl Background="Transparent" BorderThickness="0" Margin="20">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="GIÁM SÁT TRẠNG THÁI CĂN HỘ">
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,15,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DANH SÁCH CÁC CĂN HỘ TRONG TÒA NHÀ" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Apartments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="280" BorderThickness="1" CornerRadius="8" Margin="0,0,20,20" Padding="15">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    <Setter Property="Background" Value="#F1F8E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNormal}" Value="False">
                                                            <Setter Property="BorderBrush" Value="#F44336"/>
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="{Binding ApartmentName}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Trạng thái: Ổn định"/>
                                                            <Setter Property="Foreground" Value="#388E3C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNormal}" Value="False">
                                                                    <Setter Property="Text" Value="Trạng thái: CẢNH BÁO BẤT THƯỜNG"/>
                                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Content="GỬI TIN NHẮN TỚI CHỦ HỘ" Command="{Binding DataContext.SendMessageToResidentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        Background="#2196F3" Foreground="White" FontWeight="SemiBold" Padding="10" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="TRUNG TÂM HỖ TRỢ &amp; CẢNH BÁO">
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,15,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DANH SÁCH YÊU CẦU CẦN XỬ LÝ" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ActiveAlerts}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="2" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock Text="{Binding ApartmentName, StringFormat='Từ: {0}'}" FontWeight="Bold" FontSize="18" Foreground="#D32F2F"/>
                                                <TextBlock Text="{Binding Time, StringFormat='Thời gian tiếp nhận: {0}'}" FontSize="13" Foreground="#888" Margin="0,5,0,5"/>
                                                <TextBlock Text="{Binding Message}" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="ĐÃ TIẾP NHẬN &amp; XỬ LÝ" Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Background="#CCB71C1C" Panel.ZIndex="999">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasEmergency}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⚠️ BÁO ĐỘNG KHẨN CẤP ⚠️" FontSize="50" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Có căn hộ đang gửi yêu cầu cứu hộ hoặc thông số vượt ngưỡng!" FontSize="20" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,30"/>
                <Button Content="XEM CHI TIẾT TẠI TRUNG TÂM HỖ TRỢ" 
                        Click="ClosePopup_Click"
                        Background="White" Foreground="#B71C1C" FontSize="18" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>