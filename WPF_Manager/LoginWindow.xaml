<Window x:Class="WPF_Manager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập Quản Lý Tòa Nhà" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#263238" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="10" Margin="30" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="BMS ADMIN PANEL" FontSize="22" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Đăng nhập dành cho Ban Quản Lý" FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Tài khoản Quản lý" FontSize="14" Foreground="#333" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="5,0" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="Mật khẩu" FontSize="14" Foreground="#333" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPassword" Height="35" Padding="5,0" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="ĐĂNG NHẬP HỆ THỐNG" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}"
                    Background="#D32F2F" Foreground="White" FontSize="14" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>