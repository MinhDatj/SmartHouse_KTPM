<Window x:Class="WPF_Resident.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="10" Margin="30" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="SMART APARTMENT" FontSize="22" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Vui lòng đăng nhập để tiếp tục" FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Tài khoản" FontSize="14" Foreground="#333" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Height="35" Padding="5,0" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="Mật khẩu" FontSize="14" Foreground="#333" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPassword" 
                         Height="35" Padding="5,0" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="13" TextWrapping="Wrap" 
           HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="ĐĂNG NHẬP" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}"
                    Background="#2196F3" Foreground="White" FontSize="14" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Border>
</Window>